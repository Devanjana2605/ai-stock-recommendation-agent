        224,
        0
      ]
    },
    {
      "parameters": {
        "toolDescription": "Use this tool to retrieve market data for a stock ticker.\n\nInput:\nA stock ticker symbol such as AAPL, MSFT, NVDA, etc.\n\nReturns:\nRecent end-of-day stock market data including open, high, low,\nclose, adjusted close, volume, symbol and exchange.\n\nUse this tool whenever you need actual market data.\nNever invent stock prices.",
        "url": "https://api.marketstack.com/v2/eod/latest",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_key",
              "value": "Marketstack_API_KEY"
            },
            {
              "name": "symbols",
              "value": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('parameters1_Value', `The stock ticker symbol to retrieve market data for.\nExample: AAPL, MSFT, NVDA.\nUse the appropriate ticker symbol for the stock being analyzed.`, 'string') }}"
            }
          ]
        },
